<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TelX"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".ui.AuthActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.stories.StoriesActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.Story" />

        <activity
            android:name=".ui.profile.UserProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.settings.SessionsActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.contacts.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.contacts.PickUsersActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.contacts.PickSecretActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.chats.CreateChannelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.settings.BackupActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.settings.BackupViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <service
            android:name=".svc.PollService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".svc.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".svc.QuickReplyReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.telx.app.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
