<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.TelX"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name="com.telx.app.ui.AuthActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <!-- v6: selectable launcher icons (Settings → App Icon) -->
        <activity-alias
            android:name="com.telx.app.AliasDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity="com.telx.app.ui.AuthActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.telx.app.AliasDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_dark"
            android:targetActivity="com.telx.app.ui.AuthActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.telx.app.AliasTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_teal"
            android:targetActivity="com.telx.app.ui.AuthActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.stories.StoriesActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.Story" />

        <activity
            android:name=".ui.profile.UserProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.common.CropActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.Crop" />

        <activity
            android:name=".ui.common.PhotoViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.Crop" />

        <activity
            android:name=".ui.chat.WallpaperActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <!-- v6 activities -->
        <activity android:name=".ui.common.BrowserActivity" android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" android:configChanges="orientation|screenSize" />
        <activity android:name=".ui.chat.CommentsActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.TelX.NoActionBar" />
        <activity android:name=".ui.chat.PhotoEditActivity" android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />
        <activity android:name=".ui.chat.VideoTrimActivity" android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />
        <activity android:name=".ui.chat.VideoPlayerActivity" android:exported="false"
            android:supportsPictureInPicture="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.TelX.NoActionBar" />
        <activity android:name=".ui.settings.StatsActivity" android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />
        <activity android:name=".ui.settings.StorageActivity" android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />
        <activity android:name=".ui.settings.HiddenChatsActivity" android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />
        <activity android:name=".ui.settings.ThemeEditorActivity" android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.settings.SessionsActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.contacts.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.contacts.PickUsersActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.contacts.PickSecretActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.chats.CreateChannelActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.settings.BackupActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <activity
            android:name=".ui.settings.BackupViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.TelX.NoActionBar" />

        <service
            android:name=".svc.PollService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".svc.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".svc.QuickReplyReceiver"
            android:exported="false" />

        <!-- v6: home-screen chats widget -->
        <receiver
            android:name=".widget.ChatsWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/chats_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.telx.app.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
