<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">
    <com.telx.app.ui.common.CropView android:id="@+id/crop_view"
        android:layout_width="match_parent" android:layout_height="match_parent" />
    <ImageView android:id="@+id/btn_crop_cancel"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="10dp" android:layout_marginTop="26dp"
        android:src="@drawable/ic_close" app:tint="#FFFFFF" android:padding="10dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Cancel" />
    <TextView android:id="@+id/crop_title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="34dp"
        android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_crop_done"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_margin="22dp"
        android:src="@drawable/ic_done" app:tint="#FFFFFF"
        app:backgroundTint="@color/tg_blue" app:borderWidth="0dp"
        app:elevation="4dp" android:contentDescription="Done" />
</FrameLayout>
