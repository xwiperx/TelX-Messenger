<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="10dp"
    android:paddingTop="2dp" android:paddingBottom="2dp">
    <LinearLayout android:id="@+id/msg_bubble" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:orientation="vertical"
        android:background="@drawable/bg_bubble_mine"
        android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="7dp" android:paddingBottom="7dp">
        <TextView android:id="@+id/msg_fwd" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/bubble_fwd_mine" android:visibility="gone" />
        <LinearLayout android:id="@+id/msg_reply_block" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_reply_strip_mine"
            android:padding="6dp" android:layout_marginBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/msg_reply_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" />
            <TextView android:id="@+id/msg_reply_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#D8E9FF" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/msg_media_image" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:src="@drawable/media_placeholder" android:visibility="gone"
            android:layout_marginBottom="4dp" android:contentDescription="media" />
        <LinearLayout android:id="@+id/msg_album" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone" android:layout_marginBottom="4dp">
            <ImageView android:id="@+id/album_cell_1" android:layout_width="96dp" android:layout_height="96dp" android:scaleType="centerCrop"
                android:layout_marginEnd="3dp" android:background="#22000000" android:contentDescription="album photo" />
            <ImageView android:id="@+id/album_cell_2" android:layout_width="96dp" android:layout_height="96dp" android:scaleType="centerCrop"
                android:layout_marginEnd="3dp" android:background="#22000000" android:contentDescription="album photo" />
            <ImageView android:id="@+id/album_cell_3" android:layout_width="96dp" android:layout_height="96dp" android:scaleType="centerCrop"
                android:layout_marginEnd="3dp" android:background="#22000000" android:contentDescription="album photo" />
            <ImageView android:id="@+id/album_cell_4" android:layout_width="96dp" android:layout_height="96dp" android:scaleType="centerCrop"
                android:background="#22000000" android:contentDescription="album photo" />
        </LinearLayout>
        <TextView android:id="@+id/msg_comments" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/tg_blue" android:visibility="gone"
            android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Comments" />
        <LinearLayout android:id="@+id/msg_file_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
            android:layout_marginEnd="40dp">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_doc"
                app:tint="#FFFFFF" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/msg_file_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textColor="#FFFFFF" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/msg_file_size" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#D8E9FF" />
                    <ProgressBar android:id="@+id/msg_file_progress" style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="6dp" android:max="100"
                        android:progressTint="#FFFFFF" android:visibility="gone"
                        android:layout_marginTop="4dp" />
                    <TextView android:id="@+id/msg_file_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="11sp" android:textColor="#B8D4FF" android:visibility="gone"
                        android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/msg_voice_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
            android:layout_marginEnd="40dp">
            <ImageView android:id="@+id/msg_voice_btn" android:layout_width="38dp" android:layout_height="38dp"
                android:src="@drawable/ic_play" app:tint="#FFFFFF"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:padding="6dp" />

            <com.telx.app.ui.common.WaveformView android:id="@+id/msg_voice_wave"
                android:layout_width="90dp" android:layout_height="26dp"
                android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />            <TextView android:id="@+id/msg_voice_duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:textSize="13sp" android:textColor="#D8E9FF" />
        </LinearLayout>
        <TextView android:id="@+id/msg_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15.5sp" android:textColor="#FFFFFF"
            android:autoLink="web" android:textIsSelectable="false" />
        <LinearLayout android:id="@+id/msg_link_block" android:layout_width="220dp" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" android:layout_marginTop="4dp">
            <TextView android:id="@+id/msg_link_site" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#D8E9FF" android:maxLines="1" />
            <TextView android:id="@+id/msg_link_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="2" />
            <TextView android:id="@+id/msg_link_desc" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#D8E9FF" android:maxLines="3" android:ellipsize="end" />
            <ImageView android:id="@+id/msg_link_image" android:layout_width="match_parent" android:layout_height="120dp"
                android:scaleType="centerCrop" android:layout_marginTop="4dp" android:visibility="gone"
                android:contentDescription="link preview" />
        </LinearLayout>
        <ImageView android:id="@+id/msg_sticker_img" android:layout_width="150dp" android:layout_height="150dp"
            android:layout_gravity="center_horizontal" android:visibility="gone" android:contentDescription="sticker" />
        <LinearLayout android:id="@+id/msg_location_block" android:layout_width="200dp" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" android:layout_marginBottom="4dp">
            <ImageView android:id="@+id/msg_location_img" android:layout_width="200dp" android:layout_height="90dp"
                android:scaleType="centerCrop" android:background="#3390EC" android:contentDescription="map" />
            <TextView android:id="@+id/msg_location_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#FFFFFF" android:paddingTop="5dp" android:maxLines="1" />
            <TextView android:id="@+id/msg_location_coords" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:textColor="#D8E9FF" android:maxLines="1" />
            <TextView android:id="@+id/msg_location_open" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#FFFFFF" android:paddingTop="6dp" android:text="Open in Maps →" />
        </LinearLayout>
        <LinearLayout android:id="@+id/msg_contact_block" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
            android:layout_marginBottom="4dp" android:background="?android:attr/selectableItemBackground" android:padding="4dp">
            <TextView android:id="@+id/msg_contact_initial" android:layout_width="44dp" android:layout_height="44dp"
                android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="#FFFFFF" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="10dp">
                <TextView android:id="@+id/msg_contact_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1" />
                <TextView android:id="@+id/msg_contact_username" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="#D8E9FF" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/msg_round_video" android:layout_width="190dp" android:layout_height="190dp"
            android:layout_gravity="center_horizontal" android:visibility="gone" android:contentDescription="video message" />
        <LinearLayout android:id="@+id/msg_reactions" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone" android:layout_marginTop="3dp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_gravity="end">
            <TextView android:id="@+id/msg_flags" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:layout_marginEnd="3dp" android:visibility="gone" />
            <TextView android:id="@+id/msg_edited" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/bubble_time_mine" android:layout_marginEnd="4dp" android:visibility="gone" />
            <TextView android:id="@+id/msg_views" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/bubble_time_mine" android:layout_marginEnd="4dp" android:visibility="gone" />
            <TextView android:id="@+id/msg_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10.5sp" android:textColor="@color/bubble_time_mine" />
            <ImageView android:id="@+id/msg_status" android:layout_width="13dp" android:layout_height="13dp"
                android:layout_marginStart="3dp" android:visibility="gone" />
            <ImageView android:id="@+id/msg_ticks" android:layout_width="15dp" android:layout_height="15dp"
                android:layout_marginStart="3dp" android:src="@drawable/ic_check_single" app:tint="#B8FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
