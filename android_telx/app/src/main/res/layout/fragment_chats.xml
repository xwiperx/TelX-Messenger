<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/chats_swipe"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/chats_recycler"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingTop="4dp" android:paddingBottom="8dp"
            tools:listitem="@layout/item_chat" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <TextView android:id="@+id/chats_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:text="No chats yet\nTap + to start messaging"
        android:gravity="center" android:textColor="@color/text_secondary" android:textSize="15sp"
        android:visibility="gone" />
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab_new"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_margin="18dp"
        android:src="@drawable/ic_edit" app:tint="#FFFFFF" app:backgroundTint="@color/tg_blue"
        app:borderWidth="0dp" app:elevation="6dp" />
</FrameLayout>
