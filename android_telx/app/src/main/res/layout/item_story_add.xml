<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="72dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal" android:paddingStart="10dp" android:paddingEnd="6dp">
    <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
        <ImageView android:layout_width="64dp" android:layout_height="64dp"
            android:src="@drawable/ring_seen" android:contentDescription="ring" />
        <com.telx.app.ui.common.AvatarView android:id="@+id/story_add_avatar"
            android:layout_width="54dp" android:layout_height="54dp"
            android:layout_gravity="center" />
        <FrameLayout android:layout_width="20dp" android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/badge_unread">
            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                android:layout_gravity="center" android:src="@drawable/ic_add"
                app:tint="#FFFFFF" android:contentDescription="add story" />
        </FrameLayout>
    </FrameLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="My story" android:textSize="11sp"
        android:textColor="@color/text_secondary" android:maxLines="1" />
</LinearLayout>
