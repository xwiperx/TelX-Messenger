<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/window_bg">
    <androidx.appcompat.widget.Toolbar android:id="@+id/viewer_toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg" xmlns:app="http://schemas.android.com/apk/res-auto"
        app:titleTextColor="@color/text_primary" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/viewer_recycler"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="12dp" />
    <TextView android:id="@+id/viewer_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:text="Backup is empty" android:textColor="@color/text_secondary"
        android:visibility="gone" />
</LinearLayout>
