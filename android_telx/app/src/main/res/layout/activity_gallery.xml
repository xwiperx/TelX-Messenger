<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/window_bg">
    <androidx.appcompat.widget.Toolbar android:id="@+id/gallery_toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg" app:titleTextColor="@color/text_primary" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/gallery_recycler"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:id="@+id/gallery_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="No media yet" android:textSize="15sp"
            android:textColor="@color/text_secondary" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
