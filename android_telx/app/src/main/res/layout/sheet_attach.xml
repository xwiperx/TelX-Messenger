<?xml version="1.0" encoding="utf-8"?>
<!-- v7 attach sheet: fully rewritten — the old file had a nesting bug that hid
     most rows. Every row is now a proper sibling; new: Poll, To-Do, GIF. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="20dp" android:background="@color/window_bg">
    <View android:layout_width="36dp" android:layout_height="4dp" android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp" android:background="@color/divider" />

    <LinearLayout android:id="@+id/attach_photo"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_image" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Photo or Video" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_edit_photo"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_rotate" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Edit photo (filters, rotate)" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_album"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_image" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Album — send up to 6 photos" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_poll"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_poll" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Poll / Quiz" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_todo"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_todo" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Checklist (shared to-do)" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_gif"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_image" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Search GIFs" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_file"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_doc" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="File" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_trim"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_scissors" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Trim video before sending" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_music"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_music" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Audio files (music player)" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_sticker"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_emoji" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Sticker" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_videonote"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_camera" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Video Message" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_location"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_pin" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Location" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_contact"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_person" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Contact" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/attach_gallery"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?android:attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_select" app:tint="@color/tg_blue" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="18dp" android:text="Media Gallery" android:textSize="15sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</LinearLayout>
