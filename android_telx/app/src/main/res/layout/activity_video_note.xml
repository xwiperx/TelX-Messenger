<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">
    <SurfaceView android:id="@+id/vn_surface"
        android:layout_width="300dp" android:layout_height="300dp"
        android:layout_gravity="center" />
    <ImageView android:id="@+id/vn_close"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="top|end" android:padding="12dp"
        android:src="@drawable/ic_close" app:tint="#FFFFFF" />
    <ImageView android:id="@+id/vn_record"
        android:layout_width="76dp" android:layout_height="76dp"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="46dp"
        android:src="@drawable/ic_play" android:padding="18dp"
        android:background="@drawable/bg_camera_badge" />
    <TextView android:id="@+id/vn_hint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="14dp"
        android:text="Tap to record a round video message" android:textSize="13sp" android:textColor="#FFFFFF" />
</FrameLayout>
