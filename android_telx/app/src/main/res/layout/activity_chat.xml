<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:id="@+id/chat_root" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/chat_bg">
    <androidx.appcompat.widget.Toolbar android:id="@+id/chat_toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg" app:contentInsetStartWithNavigation="0dp"
        app:titleTextColor="@color/text_primary">
        <LinearLayout android:id="@+id/chat_header"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground">
            <com.telx.app.ui.common.AvatarView android:id="@+id/chat_avatar" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="8dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/chat_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/chat_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/text_secondary" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <LinearLayout android:id="@+id/pinned_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/toolbar_bg" android:paddingStart="16dp" android:paddingEnd="8dp"
        android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
        <View android:layout_width="3dp" android:layout_height="30dp" android:background="@color/tg_blue" />
        <TextView android:id="@+id/pinned_text" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:textSize="13sp"
            android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/pinned_close" android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_close" app:tint="@color/text_secondary" android:padding="2dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/chat_recycler"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="6dp" android:paddingTop="6dp" />
        <TextView android:id="@+id/chat_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="No messages here yet.
Say hi 👋"
            android:gravity="center" android:textColor="@color/text_secondary" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:id="@+id/reply_bar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/toolbar_bg" android:paddingStart="16dp" android:paddingEnd="8dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone">
        <View android:layout_width="3dp" android:layout_height="32dp" android:background="@color/tg_blue" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/reply_mode" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/tg_blue" android:textStyle="bold" />
            <TextView android:id="@+id/reply_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/text_primary" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/reply_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/text_secondary" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageView android:id="@+id/reply_close" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_close" app:tint="@color/text_secondary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/recording_bar" android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_recording" android:paddingStart="18dp" android:paddingEnd="18dp"
        android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="6dp"
        android:visibility="gone">
        <TextView android:id="@+id/recording_time" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="● 0:00" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Release to send" android:textColor="#FFE9E9" android:textSize="13sp" />
        <ImageView android:id="@+id/recording_cancel" android:layout_width="26dp" android:layout_height="26dp"
            android:layout_marginStart="12dp" android:src="@drawable/ic_close" app:tint="#FFFFFF" />
    </LinearLayout>
    <LinearLayout android:id="@+id/input_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="bottom"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp">
        <ImageView android:id="@+id/btn_attach" android:layout_width="44dp" android:layout_height="48dp"
            android:src="@drawable/ic_attach" app:tint="@color/text_secondary" android:padding="10dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <ImageView android:id="@+id/btn_emoji" android:layout_width="40dp" android:layout_height="48dp"
            android:src="@drawable/ic_emoji" app:tint="@color/text_secondary" android:padding="11dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Emoji" />
        <EditText android:id="@+id/chat_input" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/bg_input"
            android:hint="Message" android:textSize="15sp" android:maxLines="6"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:inputType="textMultiLine|textCapSentences" android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />
        <ImageView android:id="@+id/btn_mic" android:layout_width="44dp" android:layout_height="48dp"
            android:src="@drawable/ic_mic" app:tint="#FFFFFF" android:padding="11dp"
            android:background="@drawable/badge_unread" android:layout_marginStart="6dp" android:layout_marginBottom="2dp"
            android:contentDescription="Hold to record" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/btn_send"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:src="@drawable/ic_send" app:tint="#FFFFFF" app:backgroundTint="@color/tg_blue"
            app:borderWidth="0dp" app:fabSize="mini" android:layout_marginStart="6dp" android:visibility="gone"
            app:elevation="0dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/channel_bar" android:layout_width="match_parent" android:layout_height="52dp"
        android:orientation="horizontal" android:gravity="center" android:background="@color/toolbar_bg"
        android:elevation="6dp" android:visibility="gone">
        <ImageView android:id="@+id/channel_mute_icon" android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_volume" app:tint="@color/tg_blue" />
        <TextView android:id="@+id/channel_mute_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="Mute" android:textSize="15sp"
            android:textStyle="bold" android:textColor="@color/tg_blue" />
    </LinearLayout>
</LinearLayout>
