<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:background="@color/window_bg" android:padding="24dp">
    <FrameLayout android:layout_width="120dp" android:layout_height="120dp" android:layout_marginTop="40dp">
        <com.telx.app.ui.common.AvatarView android:id="@+id/profile_avatar" android:layout_width="120dp" android:layout_height="120dp" />
        <ImageView android:layout_width="34dp" android:layout_height="34dp"
            android:layout_gravity="bottom|end" android:src="@drawable/ic_camera"
            app:tint="#FFFFFF" android:background="@drawable/bg_camera_badge" android:padding="7dp" />
    </FrameLayout>
    <TextView android:id="@+id/profile_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text_primary" />
    <TextView android:id="@+id/profile_username" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="15sp" android:textColor="@color/tg_blue" />
    <TextView android:id="@+id/profile_bio" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="@color/text_secondary"
        android:gravity="center" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_edit_profile"
        android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="28dp"
        android:text="Edit Profile" app:cornerRadius="25dp" />
</LinearLayout>
