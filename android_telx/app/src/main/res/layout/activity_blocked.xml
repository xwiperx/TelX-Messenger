<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/window_bg">
    <androidx.appcompat.widget.Toolbar android:id="@+id/blocked_toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/blocked_recycler"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        tools:listitem="@layout/item_contact" />
    <TextView android:id="@+id/blocked_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:text="No blocked users" android:textColor="@color/text_secondary"
        android:visibility="gone" />
</LinearLayout>
