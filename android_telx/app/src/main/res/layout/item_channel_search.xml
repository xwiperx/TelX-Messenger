<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="56dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp"
    android:background="?android:attr/selectableItemBackground">
    <com.telx.app.ui.common.AvatarView android:id="@+id/chan_avatar"
        android:layout_width="40dp" android:layout_height="40dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/chan_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/chan_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/text_secondary" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/chan_action" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="JOIN" android:textSize="13sp" android:textStyle="bold"
        android:textColor="@color/tg_blue" android:background="?android:attr/selectableItemBackground"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="8dp" android:paddingBottom="8dp" />
</LinearLayout>
