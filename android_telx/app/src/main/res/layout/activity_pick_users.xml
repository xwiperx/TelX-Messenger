<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/window_bg">
    <androidx.appcompat.widget.Toolbar android:id="@+id/pick_toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg" />
    <TextView android:id="@+id/pick_counter" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp"
        android:text="0 selected" android:textColor="@color/text_secondary" android:textSize="13sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pick_recycler"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        tools:listitem="@layout/item_pick_user" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_create"
        android:layout_width="match_parent" android:layout_height="52dp" android:layout_margin="16dp"
        android:text="Create Group" app:cornerRadius="26dp" />
</LinearLayout>
