<?xml version="1.0" encoding="utf-8"?>
<!-- v7 tablet/two-pane layout: centered column + glass bottom bar (matches phone ids). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/window_bg"
    android:gravity="center_horizontal"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/main_toolbar"
        android:layout_width="560dp" android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg"
        app:title="TelX" app:titleTextColor="@color/text_primary"
        app:menu="@menu/menu_main" />

    <FrameLayout android:id="@+id/fragment_container"
        android:layout_width="560dp" android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="560dp" android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_bar"
        app:elevation="10dp"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/drawer_item"
        app:itemTextColor="@color/drawer_item"
        app:itemActiveIndicatorStyle="@style/Widget.TelX.GlassIndicator"
        app:menu="@menu/menu_bottom" />
</LinearLayout>
