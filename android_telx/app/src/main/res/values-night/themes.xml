<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Telegram night palette: #17212B surfaces, #0E1621 chat bg -->
    <style name="Theme.TelX" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/tg_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#1C2C3A</item>
        <item name="colorSecondary">@color/tg_blue</item>
        <item name="android:colorBackground">@color/window_bg</item>
        <item name="colorSurface">@color/window_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/toolbar_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
    </style>

    <style name="Theme.TelX.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.TelX.Story">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- v7 Liquid Glass: pill indicator on the bottom bar -->
    <style name="Widget.TelX.GlassIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/glass_tint</item>
    </style>
</resources>
